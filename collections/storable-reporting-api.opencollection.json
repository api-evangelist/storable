{
  "opencollection": "1.0.0",
  "info": {
    "name": "Storable Edge (storEDGE) Delinquency & Auctions Reporting API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Reporting",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Request a facility-level report bundle",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.storedgefms.com/v1/:facility_id/report_requests",
            "params": [
              {
                "name": "facility_id",
                "value": "",
                "type": "path",
                "description": "The storEDGE facility ID the request is scoped to."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Request a facility-level report bundle"
        },
        {
          "info": {
            "name": "Get the status of a facility-level report request",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.storedgefms.com/v1/:facility_id/report_requests/:id",
            "params": [
              {
                "name": "facility_id",
                "value": "",
                "type": "path",
                "description": "The storEDGE facility ID the request is scoped to."
              },
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get the status of a facility-level report request"
        },
        {
          "info": {
            "name": "Get the completed JSON result of a facility-level report request",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.storedgefms.com/v1/:facility_id/report_requests/:id/completed_json",
            "params": [
              {
                "name": "facility_id",
                "value": "",
                "type": "path",
                "description": "The storEDGE facility ID the request is scoped to."
              },
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get the completed JSON result of a facility-level report request"
        },
        {
          "info": {
            "name": "Request a company-level report bundle across facilities",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.storedgefms.com/v1/companies/:company_id/report_requests",
            "params": [
              {
                "name": "company_id",
                "value": "",
                "type": "path",
                "description": "The storEDGE company (multi-facility account) ID."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Request a company-level report bundle across facilities"
        }
      ]
    }
  ],
  "bundled": true
